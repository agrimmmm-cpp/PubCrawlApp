{
  "expo": {
    "name": "DrunkVA",
    "slug": "drunkva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drunkva",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F10"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DrunkVA uses your location to show nights out near you. It stays on your phone and only a rough area is used to search."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "DrunkVA uses the camera so you can snap photos and short videos of your night and your side quests. They stay on your phone until you choose to share them.",
          "microphonePermission": "DrunkVA records sound only when you film a short video moment.",
          "photosPermission": "DrunkVA can pick a photo from your library for a moment."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5C00"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
